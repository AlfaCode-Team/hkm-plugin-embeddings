{
    "name": "alfacode-team/hkm-plugin-embeddings",
    "description": "HKM Kernel plugin providing 'embedding.generation' — EmbeddingPort with a content-hash cache, a deterministic local embedder and an OpenAI-compatible HTTP adapter.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "hkm-kernel",
        "plugin",
        "php",
        "embeddings",
        "vector",
        "openai",
        "embedding.generation"
    ],
    "require": {
        "php": ">=8.4",
        "alfacode-team/php-service-platform": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^11 || ^12 || ^13"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Embeddings\\": ""
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/AlfaCode-Team/hkm-kernel"
        },
        {
            "type": "vcs",
            "url": "https://github.com/AlfaCode-Team/http"
        },
        {
            "type": "vcs",
            "url": "https://github.com/AlfaCode-Team/php-io-cli"
        },
        {
            "type": "vcs",
            "url": "https://github.com/AlfaCode-Team/Let-Migrate"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hakrichTech/bindIt"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hakrichTech/type-alias"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
